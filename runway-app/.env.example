# Copy this to .env (NOT the other way round) and fill it in. Vite does not read .env.example.
#
# IMPORTANT: Vite inlines VITE_* variables at BUILD time. After editing .env you must rebuild —
# `npm run build && npm run preview` — not merely restart. A stale bundle has the old values baked in.
#
# Leave VITE_SYNC_ENABLED unset (or anything other than "true") to run local-first against IndexedDB,
# which is a fully supported mode, not a degraded one.
VITE_SYNC_ENABLED="true"
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
