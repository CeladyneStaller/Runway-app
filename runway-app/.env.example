# Copy this to .env (NOT the other way round) and fill it in. Vite does not read .env.example.
#
# IMPORTANT: Vite inlines VITE_* variables at BUILD time. After editing .env you must rebuild —
# `npm run build && npm run preview` — not merely restart. A stale bundle has the old values baked in.
#
# Leave VITE_SYNC_ENABLED unset (or anything other than "true") to run local-first against IndexedDB,
# which is a fully supported mode, not a degraded one.
VITE_SYNC_ENABLED=true
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Where emailed auth links (magic link, password reset, email confirmation) should come back to.
#
# OPTIONAL, and only for hosted deployments that have a canonical domain. Leave it unset locally: the
# app falls back to whatever origin it is running on, which is correct for dev and preview builds.
#
# SET IT IN PRODUCTION. Without it, a link requested from a per-deployment URL — Vercel previews look
# like runway-git-branch-you.vercel.app — comes back to THAT url, and Vercel's Deployment Protection
# answers with a Vercel login page rather than this app. The email and the token are both fine; the
# destination is wrong.
#
# TWO THINGS OUTSIDE THIS FILE HAVE TO AGREE WITH IT, or the redirect is discarded in silence:
#   1. Supabase → Authentication → URL Configuration → Redirect URLs must contain this origin.
#      A redirect that is not on that allow-list is NOT rejected — it is ignored, and the link falls
#      back to the project's Site URL, with no error anywhere.
#   2. Supabase → Authentication → URL Configuration → Site URL should be this same origin, since it
#      is what any unlisted redirect falls back to.
# And in Vercel → Settings → Deployment Protection, check whether production is protected too; if it
# is, every emailed link hits the login wall no matter which host it points at.
VITE_SITE_URL=https://your-real-domain.com

# Where scrubbed error events are POSTed. OPTIONAL and OFF by default.
#
# Nothing is sent anywhere unless this is set. `src/state/errors.js` scrubs every event before it
# leaves the browser — money-shaped numbers, email addresses, secret-named keys, query strings on
# stack frames — and DROPS objects entirely rather than truncating them, because a partial document
# is still a document.
#
# DO NOT REPLACE THIS WITH A VENDOR SDK CALLED DIRECTLY. Error SDKs capture generously by default
# (breadcrumbs, URLs, request bodies, DOM text in session replays) because for most apps that is a
# feature. This app holds salaries and funding status. Point this at a collector, or install an
# adapter in main.jsx that forwards the already-scrubbed event.
VITE_ERROR_SINK_URL=

# Tags error events with a build identifier, so Sentry can say "this started at commit a3f9c2e".
#
# NORMALLY LEAVE THIS UNSET. `vite.config.js` resolves it automatically from the CI platform's own
# variable (VERCEL_GIT_COMMIT_SHA, GITHUB_SHA, CF_PAGES_COMMIT_SHA) and falls back to "dev".
#
# In particular do NOT set it to "$VERCEL_GIT_COMMIT_SHA" in Vercel's dashboard: Vercel does not
# expand environment variables, so that stores the literal string and every deploy reports a release
# called "$VERCEL_GIT_COMMIT_SHA". Setting it here overrides, for a hand-written version number.
VITE_RELEASE=

# Sentry. Optional; error reporting stays OFF without it.
#
# The DSN from Sentry -> Settings -> Projects -> [project] -> Client Keys. It is a WRITE-ONLY
# credential and is designed to be public, so having it in the browser bundle is expected.
#
# WE DO NOT USE @sentry/browser, on purpose. `Sentry.init()` installs its own error handlers, which
# capture raw errors before this app's scrubber runs — the vendor would see unscrubbed messages. The
# envelope is posted directly instead. See `src/state/sentry.js`. Adding the SDK later would silently
# re-open that path.
VITE_SENTRY_DSN=

# Tags events so you can tell staging crashes from production ones.
VITE_ENVIRONMENT=production
